APP_ENV=local
APP_DEBUG=false
# Run `php vendor/bin/kongo key:generate` and place the generated key in your untracked .env file:
APP_KEY=REPLACE_WITH_kongo_key_generate
SESSION_SECURE=false

# AI Companions
# Set any one AI provider for Oshie, Chie & Hantei:
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434
# OPENAI_API_KEY=
