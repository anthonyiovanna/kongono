{
  "name": "kongono/asset-build",
  "description": "Deterministic native asset graph, build artifact, currentness, and content-addressed publication for Kongono Framework.",
  "type": "library",
  "require": {
    "php": ">=8.5.0 <8.6.0",
    "kongono/api-metadata": "*",
    "kongono/diagnostics": "*",
    "kongono/asset-contract": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Kongono\\AssetBuild\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kongono\\AssetBuild\\Tests\\": "tests/"
    }
  }
}
