{
  "name": "kongono/extension-admission",
  "description": "Deterministic selection, admission, and Application Graph IR projection for Kongono extensions.",
  "type": "library",
  "require": {
    "kongono/api-metadata": "*",
    "kongono/application-graph-build": "*",
    "kongono/application-graph-contract": "*",
    "kongono/diagnostics": "*",
    "kongono/extension-build": "*",
    "kongono/extension-contract": "*",
    "php": ">=8.5.0 <8.6.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Kongono\\ExtensionAdmission\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kongono\\ExtensionAdmission\\Tests\\": "tests/"
    }
  }
}
