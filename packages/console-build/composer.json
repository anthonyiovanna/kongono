{
    "name": "kongono/console-build",
    "description": "Deterministic build-time command definition compilation and validation.",
    "type": "library",
    "require": {
        "ext-hash": "*",
        "ext-json": "*",
        "kongono/api-metadata": "*",
        "kongono/console": "*",
        "kongono/diagnostics": "*",
        "php": ">=8.5.0 <8.6.0"
    },
    "autoload": {
        "psr-4": {
            "Kongono\\ConsoleBuild\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kongono\\ConsoleBuild\\Tests\\": "tests/"
        }
    }
}
