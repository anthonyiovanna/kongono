  "type": "library",
  "require": {
    "kongono/api-metadata": "*",
    "kongono/diagnostics": "*",
    "kongono/network-egress-contract": "*",
    "kongono/network-egress-runtime": "*",
    "php": ">=8.5.0 <8.6.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Kongono\\ExternalServiceContract\\": "src/"
    }
  },
  "autoload-dev": {
