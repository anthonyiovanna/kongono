{
  "name": "kongono/storage-application",
  "description": "Explicit storage profile workflow and authorized exact-current runtime composition for Kongono Framework.",
  "type": "library",
  "require": {
    "php": ">=8.5.0 <8.6.0",
    "kongono/api-metadata": "*",
    "kongono/diagnostics": "*",
    "kongono/storage-contract": "*",
    "kongono/storage-build": "*",
    "kongono/storage-adapter-contract": "*",
    "kongono/storage-runtime": "*"
  },
  "require-dev": {
    "kongono/storage-adapter-local": "*",
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Kongono\\StorageApplication\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kongono\\StorageApplication\\Tests\\": "tests/"
    }
  }
}
