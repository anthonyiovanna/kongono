{
  "name": "kongono/kernel",
  "description": "The runtime-neutral lifecycle core for Kongono Framework.",
  "type": "library",
  "require": {
    "kongono/api-metadata": "*",
    "kongono/diagnostics": "*",
    "php": ">=8.5"
  },
  "autoload": {
    "psr-4": {
