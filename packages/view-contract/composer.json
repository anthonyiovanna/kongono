{
  "name": "kongono/view-contract",
  "description": "Neutral compiled-view identities, closed presentation values, schemas, and render evidence for Kongono Framework.",
  "type": "library",
  "require": {
    "php": ">=8.5.0 <8.6.0",
    "kongono/api-metadata": "*",
    "kongono/diagnostics": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Kongono\\ViewContract\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kongono\\ViewContract\\Tests\\": "tests/"
    }
  }
}
