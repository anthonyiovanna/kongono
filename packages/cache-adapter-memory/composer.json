{
  "name": "kongono/cache-adapter-memory",
  "description": "Bounded deterministic process-local cache adapter for Kongono Framework.",
  "type": "library",
  "require": {
    "php": ">=8.5.0 <8.6.0",
    "kongono/api-metadata": "*",
    "kongono/diagnostics": "*",
    "kongono/cache-contract": "*",
    "kongono/cache-adapter-contract": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Kongono\\CacheAdapterMemory\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kongono\\CacheAdapterMemory\\Tests\\": "tests/"
    }
  }
}
