{
    "name": "kongono/console-commands",
    "description": "First read-only framework capability commands for Kongono Framework.",
    "type": "library",
    "require": {
        "kongono/api-metadata": "*",
        "kongono/application-graph": "*",
        "kongono/composition": "*",
        "kongono/console": "*",
        "kongono/console-runtime": "*",
        "kongono/diagnostics": "*",
        "kongono/hantei": "*",
        "php": ">=8.5.0 <8.6.0"
    },
    "require-dev": {
        "kongono/console-build": "*"
    },
    "autoload": {
        "psr-4": {
            "Kongono\\ConsoleCommands\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kongono\\ConsoleCommands\\Tests\\": "tests/"
        }
    }
}
