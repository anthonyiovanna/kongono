{
  "name": "kongono/observability-application",
  "description": "Explicit application observability lifecycle over Kongono signal runtimes.",
  "type": "library",
  "require": {
    "kongono/api-metadata": "*",
    "kongono/diagnostics": "*",
    "kongono/metrics": "*",
    "kongono/observability": "*",
    "kongono/observability-build": "*",
    "kongono/opentelemetry": "*",
    "kongono/operational-events": "*",
    "kongono/security-audit": "*",
    "kongono/tracing": "*",
    "php": ">=8.5.0 <8.6.0"
  },
  "autoload": {
    "psr-4": {
      "Kongono\\ObservabilityApplication\\": "src/"
    }
