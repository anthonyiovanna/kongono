{
  "name": "kongono/external-service-credential-runtime",
  "description": "Operation-scoped credential lease coordination for Kongono external services.",
  "type": "library",
  "require": {
    "php": ">=8.5.0 <8.6.0",
    "kongono/api-metadata": "*",
    "kongono/diagnostics": "*",
    "kongono/external-service-contract": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Kongono\\ExternalServiceCredentialRuntime\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kongono\\ExternalServiceCredentialRuntime\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
