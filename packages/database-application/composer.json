{
  "name": "kongono/database-application",
  "description": "Generated data-application composition and operation-owned persistence for Kongono Framework.",
  "type": "library",
  "require": {
    "kongono/api-metadata": "*",
    "kongono/composition": "*",
    "kongono/database": "*",
    "kongono/database-mapping": "*",
    "kongono/diagnostics": "*",
    "php": ">=8.5.0 <8.6.0"
  },
  "autoload": {
    "psr-4": {
      "Kongono\\DatabaseApplication\\": "src/"
    }
  },
  "autoload-dev": {
