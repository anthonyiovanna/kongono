{
  "name": "kongono/view",
  "description": "Kongono v1 compiled HTML template engine (.kgn.html) with context-aware escaping, layouts, components, Live 2.5 & Bridge directives.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://kongono.com",
  "authors": [
    {
      "name": "Anthony Iovanna",
      "email": "ant@kongono.com"
    }
  ],
  "support": {
    "issues": "https://github.com/kongono/framework/issues",
    "source": "https://github.com/kongono/framework",
    "docs": "https://kongono.com/docs"
  },
  "require": {
    "php": ">=8.5.13",
    "ext-dom": "*",
    "kongono/core": "^1.23"
  },
  "autoload": {
    "psr-4": {
      "Kongono\\View\\": "src/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  }
}
