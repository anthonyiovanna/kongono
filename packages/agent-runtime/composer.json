{
  "name": "kongono/agent-runtime",
  "description": "Provider-neutral bounded operation runtime for Kongono Agent Principals.",
  "type": "library",
  "require": {
    "php": ">=8.5.0 <8.6.0",
    "kongono/agent-admission": "*",
    "kongono/agent-declaration-build": "*",
    "kongono/agent-principal-contract": "*",
    "kongono/api-metadata": "*",
    "kongono/diagnostics": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Kongono\\AgentRuntime\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kongono\\AgentRuntime\\Tests\\": "tests/"
    }
  }
}
