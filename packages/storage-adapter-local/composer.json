{
  "name": "kongono/storage-adapter-local",
  "description": "Contained explicitly rooted local-filesystem storage adapter for Kongono Framework.",
  "type": "library",
  "require": {
    "php": ">=8.5.0 <8.6.0",
    "kongono/api-metadata": "*",
    "kongono/diagnostics": "*",
    "kongono/storage-adapter-contract": "*",
    "kongono/storage-build": "*",
    "kongono/storage-contract": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Kongono\\StorageAdapterLocal\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kongono\\StorageAdapterLocal\\Tests\\": "tests/"
    }
  }
}
