{
    "name": "kongono/persistence-application",
    "description": "Exact-current generated persistence and application composition workflow for Kongono Framework.",
    "type": "library",
    "require": {
        "kongono/api-metadata": "*",
        "kongono/composition": "*",
        "kongono/database-application": "*",
        "kongono/diagnostics": "*",
        "kongono/persistence-build": "*",
        "php": ">=8.5.0 <8.6.0"
    },
    "autoload": {
        "psr-4": {
            "Kongono\\PersistenceApplication\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kongono\\PersistenceApplication\\Tests\\": "tests/"
        }
    }
}
