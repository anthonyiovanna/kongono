  "type": "library",
  "require": {
    "php": ">=8.5.0 <8.6.0",
    "kongono/api-metadata": "*",
    "kongono/diagnostics": "*",
    "kongono/storage-build": "*",
    "kongono/storage-contract": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Kongono\\StorageAdapterContract\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kongono\\StorageAdapterContract\\Tests\\": "tests/"
    }
  }
}
