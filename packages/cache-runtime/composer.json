{
  "name": "kongono/cache-runtime",
  "description": "Exact-current bounded cache runtime with explicit time and validated adapter evidence for Kongono Framework.",
  "type": "library",
  "require": {
    "php": ">=8.5.0 <8.6.0",
    "kongono/api-metadata": "*",
    "kongono/diagnostics": "*",
    "kongono/cache-contract": "*",
    "kongono/cache-build": "*",
    "kongono/cache-adapter-contract": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Kongono\\CacheRuntime\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kongono\\CacheRuntime\\Tests\\": "tests/"
    }
  }
}
