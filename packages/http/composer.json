{
  "name": "kongono/http",
  "description": "Kongono v1 PSR-7/15 HTTP layer, attribute + fluent AOT router, Live 2.5 & Bridge frontends, Dev Studio (/_kongono), Ops Dashboard (/_ops), OpenAPI 3.1, and persistent-runtime App.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://kongono.com",
  "authors": [
    {
      "name": "Anthony Iovanna",
      "email": "ant@kongono.com"
    }
  ],
  "support": {
    "issues": "https://github.com/kongono/framework/issues",
    "source": "https://github.com/kongono/framework",
    "docs": "https://kongono.com/docs"
  },
  "require": {
    "php": ">=8.5.13",
    "kongono/core": "^1.23",
    "kongono/jobs": "^1.23",
    "kongono/security": "^1.23",
    "kongono/storage": "^1.23",
    "kongono/validation": "^1.23",
    "kongono/view": "^1.23",
    "psr/http-factory": "^1.1",
    "psr/http-message": "^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Kongono\\Http\\": "src/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  }
}
