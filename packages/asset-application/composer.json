{
    "name": "kongono/asset-application",
    "description": "Explicit exact-current application workflow for Kongono assets.",
    "type": "library",
    "require": {
        "php": ">=8.5.0 <8.6.0",
        "kongono/api-metadata": "*",
        "kongono/diagnostics": "*",
        "kongono/asset-contract": "*",
        "kongono/asset-build": "*",
        "kongono/asset-adapter-contract": "*",
        "kongono/asset-resolution": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Kongono\\AssetApplication\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kongono\\AssetApplication\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
