{
  "name": "kongono/storage-contract",
  "description": "Provider-neutral bounded storage identities, requests, results, and lifecycle contracts for Kongono Framework.",
  "type": "library",
  "require": {
    "php": ">=8.5.0 <8.6.0",
    "kongono/api-metadata": "*",
    "kongono/diagnostics": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Kongono\\StorageContract\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kongono\\StorageContract\\Tests\\": "tests/"
    }
  }
}
