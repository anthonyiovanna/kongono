{
  "name": "kongono/database-pdo-pgsql",
  "description": "PostgreSQL PDO proof adapter for Kongono's neutral database contracts.",
  "type": "library",
  "require": {
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "kongono/database": "*",
    "php": ">=8.5.0 <8.6.0"
  },
  "autoload": {
    "psr-4": {
      "Kongono\\DatabasePdoPgsql\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kongono\\DatabasePdoPgsql\\Tests\\": "tests/"
    }
  }
}
