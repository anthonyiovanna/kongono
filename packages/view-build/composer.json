{
    "name": "kongono/view-build",
    "description": "Deterministic structured view-source compilation and content-addressed artifact publication for Kongono Framework.",
    "type": "library",
    "require": {
        "php": ">=8.5.0 <8.6.0",
        "kongono/api-metadata": "*",
        "kongono/diagnostics": "*",
        "kongono/view-contract": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Kongono\\ViewBuild\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kongono\\ViewBuild\\Tests\\": "tests/"
        }
    }
}
