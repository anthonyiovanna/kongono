{
  "name": "kongono/cache-application",
  "description": "Explicit cache profile workflow and exact-current runtime composition for Kongono Framework.",
  "type": "library",
  "require": {
    "php": ">=8.5.0 <8.6.0",
    "kongono/api-metadata": "*",
    "kongono/diagnostics": "*",
    "kongono/cache-contract": "*",
    "kongono/cache-build": "*",
    "kongono/cache-adapter-contract": "*",
    "kongono/cache-runtime": "*"
  },
  "require-dev": {
    "kongono/cache-adapter-memory": "*",
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Kongono\\CacheApplication\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kongono\\CacheApplication\\Tests\\": "tests/"
    }
  }
}
