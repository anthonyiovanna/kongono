{
  "name": "kongono/cli",
  "description": "Kongono v1 `kongo` CLI, 5-pillar readiness prover, 17-rule Full-Stack Contract Prover, LSP 3.17, 26-tool MCP server, and built-in Oshie, Chie & Hantei AI companions.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://kongono.com",
  "authors": [
    {
      "name": "Anthony Iovanna",
      "email": "ant@kongono.com"
    }
  ],
  "support": {
    "issues": "https://github.com/kongono/framework/issues",
    "source": "https://github.com/kongono/framework",
    "docs": "https://kongono.com/docs"
  },
  "require": {
    "php": ">=8.5.13",
    "ext-json": "*",
    "kongono/ai": "^1.22",
    "kongono/core": "^1.22",
    "kongono/database": "^1.22",
    "kongono/http": "^1.22",
    "kongono/jobs": "^1.22",
    "kongono/mail": "^1.22",
    "kongono/security": "^1.22",
    "kongono/validation": "^1.22",
    "kongono/view": "^1.22"
  },
  "autoload": {
    "psr-4": {
      "Kongono\\Cli\\": "src/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  }
}
