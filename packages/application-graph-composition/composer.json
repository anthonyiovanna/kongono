{
  "name": "kongono/application-graph-composition",
  "description": "Deterministic Composition-to-IR projection and authoritative Application Graph construction for Kongono.",
  "type": "library",
  "require": {
    "ext-hash": "*",
    "ext-json": "*",
    "kongono/api-metadata": "*",
    "kongono/application-graph-build": "*",
    "kongono/application-graph-contract": "*",
    "kongono/composition": "*",
    "kongono/diagnostics": "*",
    "php": ">=8.5.0 <8.6.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Kongono\\ApplicationGraphComposition\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kongono\\ApplicationGraphComposition\\Tests\\": "tests/"
    }
  }
}
