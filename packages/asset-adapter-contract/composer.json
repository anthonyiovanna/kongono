{
  "name": "kongono/asset-adapter-contract",
  "description": "Replaceable deterministic asset-build adapter contracts and validated adapter artifacts for Kongono Framework.",
  "type": "library",
  "require": {
    "php": ">=8.5.0 <8.6.0",
    "kongono/api-metadata": "*",
    "kongono/diagnostics": "*",
    "kongono/asset-contract": "*",
    "kongono/asset-build": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Kongono\\AssetAdapterContract\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kongono\\AssetAdapterContract\\Tests\\": "tests/"
    }
  }
}
