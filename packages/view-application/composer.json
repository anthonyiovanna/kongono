{
    "name": "kongono/view-application",
    "description": "Exact-current compiled-view application workflow and response composition for Kongono Framework.",
    "type": "library",
    "require": {
        "php": ">=8.5.0 <8.6.0",
        "kongono/api-metadata": "*",
        "kongono/diagnostics": "*",
        "kongono/view-build": "*",
        "kongono/view-contract": "*",
        "kongono/view-http": "*",
        "kongono/view-runtime": "*",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "kongono/http-message": "*",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Kongono\\ViewApplication\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kongono\\ViewApplication\\Tests\\": "tests/"
        }
    }
}
