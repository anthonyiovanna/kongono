{
  "name": "kongono/storage-inspection",
  "description": "Visibility-safe storage inspection and bounded developer intelligence for Kongono Framework.",
  "type": "library",
  "require": {
    "php": ">=8.5.0 <8.6.0",
    "kongono/api-metadata": "*",
    "kongono/application-graph-intelligence": "*",
    "kongono/storage-application": "*",
    "kongono/storage-build": "*",
    "kongono/storage-contract": "*",
    "kongono/diagnostics": "*",
    "kongono/observability": "*",
    "kongono/security-audit": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Kongono\\StorageInspection\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kongono\\StorageInspection\\Tests\\": "tests/"
    }
  }
}
