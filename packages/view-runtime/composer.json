{
    "name": "kongono/view-runtime",
    "description": "Exact-current compiled view loading and synchronous bounded rendering for Kongono Framework.",
    "type": "library",
    "require": {
        "php": ">=8.5.0 <8.6.0",
        "kongono/api-metadata": "*",
        "kongono/diagnostics": "*",
        "kongono/view-build": "*",
        "kongono/view-contract": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Kongono\\ViewRuntime\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kongono\\ViewRuntime\\Tests\\": "tests/"
        }
    }
}
