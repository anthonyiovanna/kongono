{
    "name": "kongono/network-egress-policy-build",
    "description": "Deterministic network-egress policy artifact build and publication for Kongono Framework.",
    "type": "library",
    "require": {
        "php": ">=8.5.0 <8.6.0",
        "kongono/api-metadata": "*",
        "kongono/diagnostics": "*",
        "kongono/network-egress-contract": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Kongono\\NetworkEgressPolicyBuild\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kongono\\NetworkEgressPolicyBuild\\Tests\\": "tests/"
        }
    }
}
