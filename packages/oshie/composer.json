  "type": "library",
  "require": {
    "ext-hash": "*",
    "ext-json": "*",
    "kongono/api-metadata": "*",
    "kongono/diagnostics": "*",
    "kongono/knowledge": "*",
    "php": ">=8.5.0 <8.6.0"
  },
  "autoload": {
