{
  "name": "kongono/agent-declaration-build",
  "description": "Deterministic declaration artifact build and publication for Kongono Agent Principals.",
  "type": "library",
  "require": {
    "php": ">=8.5.0 <8.6.0",
    "kongono/agent-principal-contract": "*",
    "kongono/api-metadata": "*",
    "kongono/diagnostics": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Kongono\\AgentDeclarationBuild\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kongono\\AgentDeclarationBuild\\Tests\\": "tests/"
    }
  }
}
