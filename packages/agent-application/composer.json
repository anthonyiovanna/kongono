{
  "name": "kongono/agent-application",
  "description": "Exact-current single-profile application workflow for Kongono Agent Principals.",
  "type": "library",
  "require": {
    "php": ">=8.5.0 <8.6.0",
    "kongono/agent-admission": "*",
    "kongono/agent-declaration-build": "*",
    "kongono/agent-principal-contract": "*",
    "kongono/agent-runtime": "*",
    "kongono/api-metadata": "*",
    "kongono/diagnostics": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Kongono\\AgentApplication\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kongono\\AgentApplication\\Tests\\": "tests/"
    }
  }
}
