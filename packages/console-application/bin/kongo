#!/usr/bin/env php
<?php

declare(strict_types=1);

use Kongono\ConsoleApplication\KongoApplicationFactory;
use Kongono\ConsoleApplication\Process\NativeKongoEntrypoint;

$autoload = $GLOBALS['_composer_autoload_path'] ?? dirname(__DIR__, 3) . '/vendor/autoload.php';
if (!is_string($autoload)) {
    exit(6);
}
require $autoload;

$arguments = $GLOBALS['argv'] ?? [];
if (!is_array($arguments)) {
    $arguments = [];
}

exit((new NativeKongoEntrypoint((new KongoApplicationFactory())->create()))->run(array_slice($arguments, 1), STDOUT, STDERR));
