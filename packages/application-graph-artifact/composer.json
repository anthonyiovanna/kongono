{
    "name": "kongono/application-graph-artifact",
    "description": "Canonical content-addressed Application Graph artifacts",
    "type": "library",
    "require": {
        "php": ">=8.5.0 <8.6.0",
        "ext-hash": "*",
        "ext-json": "*",
        "kongono/api-metadata": "*",
        "kongono/application-graph-build": "*",
        "kongono/application-graph-contract": "*",
        "kongono/diagnostics": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Kongono\\ApplicationGraphArtifact\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kongono\\ApplicationGraphArtifact\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
