{
  "name": "kongono/view-inspection",
  "description": "Visibility-safe compiled-view inspection and bounded developer intelligence for Kongono Framework.",
  "type": "library",
  "require": {
    "php": ">=8.5.0 <8.6.0",
    "kongono/api-metadata": "*",
    "kongono/application-graph-intelligence": "*",
    "kongono/diagnostics": "*",
    "kongono/observability": "*",
    "kongono/security-audit": "*",
    "kongono/view-application": "*",
    "kongono/view-build": "*",
    "kongono/view-contract": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Kongono\\ViewInspection\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kongono\\ViewInspection\\Tests\\": "tests/"
    }
  }
}
