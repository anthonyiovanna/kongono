{
  "name": "kongono/mail",
  "description": "Kongono v1 zero-dependency transactional email (SMTP STARTTLS, Resend HTTPS API, DevMailboxTransport, Memory/Log transports, and .kgn.html email templates).",
  "type": "library",
  "license": "MIT",
  "homepage": "https://kongono.com",
  "authors": [
    {
      "name": "Anthony Iovanna",
      "email": "ant@kongono.com"
    }
  ],
  "support": {
    "issues": "https://github.com/kongono/framework/issues",
    "source": "https://github.com/kongono/framework",
    "docs": "https://kongono.com/docs"
  },
  "require": {
    "php": ">=8.5.13",
    "ext-curl": "*",
    "kongono/core": "^1.23",
    "kongono/view": "^1.23",
    "psr/log": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Kongono\\Mail\\": "src/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  }
}
