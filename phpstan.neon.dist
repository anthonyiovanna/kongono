includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: max
    phpVersion: 80500
    paths:
        - packages/api-metadata/src
        - packages/api-metadata/tests
        - packages/application-graph/src
        - packages/application-graph/tests
        - packages/dependency-injection/src
        - packages/dependency-injection/tests
        - packages/diagnostic-activation/src
        - packages/diagnostic-activation/tests
        - packages/diagnostic-handler/src
        - packages/diagnostic-handler/tests
        - packages/diagnostic-presentation/src
        - packages/diagnostic-presentation/tests
        - packages/diagnostics/src
        - packages/diagnostics/tests
        - packages/http-message/src
        - packages/http-message/tests
        - packages/http-server/src
        - packages/http-server/tests
        - packages/kernel/src
        - packages/kernel/tests
        - packages/php-cgi/src
        - packages/php-cgi/tests
        - packages/routing/src
        - packages/routing/tests
        - packages/web-application/src
        - packages/web-application/tests
        - packages/web-runtime/src
        - packages/web-runtime/tests
        - tests/External
        - tests/Architecture
        - tests/BlackBox
        - tests/Tooling
    tmpDir: .cache/phpstan
