includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: 9
    paths:
        - packages/core/src
        - packages/http/src
        - packages/view/src
        - packages/validation/src
        - packages/database/src
        - packages/security/src
        - packages/storage/src
        - packages/jobs/src
        - packages/ai/src
        - packages/cli/src
        - examples/starter-app/src
    tmpDir: .cache/phpstan
