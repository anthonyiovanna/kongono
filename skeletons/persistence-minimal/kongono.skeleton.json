{
  "schema": "kongono.application-skeleton",
  "version": 1,
  "template_paths": [
    ".gitignore",
    "README.md",
    "bin/build.php",
    "bin/check.php",
    "composer.json",
    "composer.lock",
    "kongono.composition.json",
    "kongono.data-mapping.json",
    "kongono.persistence-repositories.json",
    "kongono.persistence.json",
    "kongono.skeleton.json",
    "src/Data/AccountRecord.php",
    "src/Data/ProfileRecord.php",
    "src/Domain/Account.php",
    "src/Domain/Profile.php",
    "src/Persistence/AccountCascadeExecutor.php",
    "src/Persistence/AccountChangeExecutor.php",
    "src/Persistence/AccountLoadExecutor.php",
    "src/Persistence/AccountStateAdapter.php",
    "src/PersistenceOperations.php",
    "src/Runtime.php",
    "var/kongono/build/.gitignore"
  ],
  "derived_output_patterns": [
    "var/kongono/build/kongono-data-mapping-v1-*.json",
    "var/kongono/build/kongono-data-access-v1-*.php",
    "var/kongono/build/persistence-artifacts/v1/kongono-persistence-v1-*.json",
    "var/kongono/build/kongono-persistence-state-v1-*.php",
    "var/kongono/build/kongono-persistence-repositories-v1-*.php",
    "var/kongono/build/kongono-composition-v1-*.json",
    "var/kongono/build/kongono-wiring-v1-*.php",
    "vendor/**"
  ]
}

