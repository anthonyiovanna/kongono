{
  "name": "kongono/asset-minimal-application",
  "description": "Minimal copy-once Kongono native asset application skeleton.",
  "type": "project",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "../../packages/*",
      "options": {
        "symlink": false
      }
    }
  ],
  "require": {
    "kongono/asset-application": "@dev",
    "kongono/view-contract": "@dev",
    "php": ">=8.5.0 <8.6.0"
  },
  "autoload": {
    "psr-4": {
      "AssetMinimalApp\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {},
    "platform": {
      "php": "8.5.0"
    },
    "preferred-install": "dist",
    "secure-http": true,
    "sort-packages": true
  },
  "scripts": {
    "asset:build": "@php bin/asset.php build",
    "asset:check": "@php bin/asset.php check",
    "asset:resolve": "@php bin/asset.php resolve"
  }
}
