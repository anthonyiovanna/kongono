{
  "name": "kongono/minimal-security-application",
  "description": "Minimal copy-once Kongono security application skeleton.",
  "type": "project",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "../../packages/*",
      "options": {
        "symlink": false
      }
    }
  ],
  "require": {
    "kongono/authentication": "@dev",
    "kongono/authorization": "@dev",
    "kongono/composition": "@dev",
    "kongono/http-message": "@dev",
    "kongono/identity-access": "@dev",
    "kongono/security-application": "@dev",
    "kongono/security-enforcement": "@dev",
    "kongono/security-http": "@dev",
    "kongono/security-policy-build": "@dev",
    "kongono/security-runtime": "@dev",
    "php": ">=8.5.0 <8.6.0"
  },
  "autoload": {
    "psr-4": {
      "KongonoSecurityMinimal\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {},
    "platform": {
      "php": "8.5.0"
    },
    "preferred-install": "dist",
    "secure-http": true,
    "sort-packages": true
  },
  "scripts": {
    "app:build": "@php bin/build.php",
    "app:check": "@php bin/check.php",
    "app:run": "@php bin/run.php"
  }
}
