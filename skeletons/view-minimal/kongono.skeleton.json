{
  "schema": "kongono.application-skeleton",
  "version": 1,
  "template_paths": [
    ".gitignore",
    "README.md",
    "bin/build.php",
    "bin/check.php",
    "bin/run.php",
    "composer.json",
    "composer.lock",
    "kongono.composition.json",
    "kongono.skeleton.json",
    "public/index.php",
    "src/Bootstrap.php",
    "src/Http/HomeHandler.php",
    "src/Http/NotFoundHandler.php",
    "src/Runtime.php",
    "var/kongono/build/.gitignore",
    "var/kongono/view/.gitignore",
    "views/home.view.json"
  ],
  "derived_output_patterns": [
    "var/kongono/build/kongono-composition-v1-*.json",
    "var/kongono/build/kongono-wiring-v1-*.php",
    "var/kongono/view/kongono-view-v1-*/artifact.json",
    "var/kongono/view/kongono-view-v1-*/compiled.php",
    "vendor/**"
  ]
}
