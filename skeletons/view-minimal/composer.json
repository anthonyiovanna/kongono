{
  "name": "kongono/view-minimal-application",
  "description": "Minimal copy-once Kongono compiled-view web application skeleton.",
  "type": "project",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "../../packages/*",
      "options": {
        "symlink": false
      }
    }
  ],
  "require": {
    "kongono/composition": "@dev",
    "kongono/http-message": "@dev",
    "kongono/http-server": "@dev",
    "kongono/kernel": "@dev",
    "kongono/php-cgi": "@dev",
    "kongono/routing": "@dev",
    "kongono/view-application": "@dev",
    "kongono/view-contract": "@dev",
    "kongono/view-http": "@dev",
    "kongono/web-application": "@dev",
    "kongono/web-runtime": "@dev",
    "php": ">=8.5.0 <8.6.0",
    "psr/http-message": "^2.0",
    "psr/http-server-handler": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "ViewMinimalApp\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {},
    "platform": {
      "php": "8.5.0"
    },
    "preferred-install": "dist",
    "secure-http": true,
    "sort-packages": true
  },
  "scripts": {
    "view:build": "@php bin/build.php",
    "view:check": "@php bin/check.php",
    "view:run": "@php bin/run.php"
  }
}
