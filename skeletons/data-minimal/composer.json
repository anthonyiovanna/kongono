{
  "name": "kongono/minimal-data-application",
  "description": "Minimal copy-once Kongono generated data application skeleton.",
  "type": "project",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "../../packages/*",
      "options": {
        "symlink": false
      }
    }
  ],
  "require": {
    "kongono/composition": "@dev",
    "kongono/database": "@dev",
    "kongono/database-application": "@dev",
    "kongono/database-mapping": "@dev",
    "kongono/database-pdo-pgsql": "@dev",
    "kongono/database-sql": "@dev",
    "kongono/database-sql-pgsql": "@dev",
    "php": ">=8.5.0 <8.6.0"
  },
  "autoload": {
    "psr-4": {
      "KongonoDataMinimal\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {},
    "platform": {
      "php": "8.5.0"
    },
    "preferred-install": "dist",
    "secure-http": true,
    "sort-packages": true
  },
  "scripts": {
    "app:build": "@php bin/build.php",
    "app:check": "@php bin/check.php"
  }
}
