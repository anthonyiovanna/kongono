{
  "name": "kongono/event-minimal-application",
  "description": "Minimal copy-once Kongono application-event example.",
  "type": "project",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "../../packages/*",
      "options": {
        "symlink": false
      }
    }
  ],
  "require": {
    "kongono/event-contract": "@dev",
    "kongono/event-runtime": "@dev",
    "php": ">=8.5.0 <8.6.0"
  },
  "autoload": {
    "psr-4": {
      "EventMinimalApp\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "EventMinimalApp\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {},
    "platform": {
      "php": "8.5.0"
    },
    "preferred-install": "dist",
    "secure-http": true,
    "sort-packages": true
  },
  "scripts": {
    "demo": "@php bin/demo.php"
  }
}
