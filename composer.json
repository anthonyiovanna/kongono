  "config": {
    "allow-plugins": {},
    "platform": {
      "php": "8.5.0"
    },
    "policy": {
      "advisories": {
        "block": true,
        "audit": "fail"
      },
      "malware": {
        "block": true,
        "block-scope": "all",
        "audit": "fail"
      },
      "abandoned": {
        "block": true,
        "audit": "fail"
      },
      "ignore-unreachable": false
    },
    "preferred-install": "dist",
    "secure-http": true,
    "sort-packages": true
  },
