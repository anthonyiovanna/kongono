{
  "name": "kongono/framework",
  "description": "A modern application framework designed for humans, software, and AI agents.",
  "type": "library",
  "repositories": [
    {
      "type": "path",
      "url": "packages/security-enforcement"
    },
    {
      "type": "path",
      "url": "packages/security-http"
    },
    {
      "type": "path",
      "url": "packages/security-runtime"
    },
    {
      "type": "path",
      "url": "packages/authorization"
    },
    {
      "type": "path",
      "url": "packages/*"
    }
  ],
  "require": {
    "kongono/api-metadata": "@dev",
    "kongono/application-graph": "@dev",
    "kongono/authentication": "@dev",
    "kongono/authorization": "@dev",
    "kongono/chie": "@dev",
    "kongono/composition": "@dev",
    "kongono/console": "@dev",
    "kongono/console-application": "@dev",
    "kongono/console-build": "@dev",
    "kongono/console-commands": "@dev",
    "kongono/console-presentation": "@dev",
    "kongono/console-runtime": "@dev",
    "kongono/database": "@dev",
    "kongono/database-application": "@dev",
    "kongono/database-mapping": "@dev",
    "kongono/database-migration": "@dev",
    "kongono/database-migration-pgsql": "@dev",
    "kongono/database-pdo-pgsql": "@dev",
    "kongono/database-sql": "@dev",
    "kongono/database-sql-pgsql": "@dev",
    "kongono/dependency-injection": "@dev",
    "kongono/diagnostic-activation": "@dev",
    "kongono/diagnostic-handler": "@dev",
    "kongono/diagnostic-presentation": "@dev",
    "kongono/diagnostics": "@dev",
    "kongono/hantei": "@dev",
    "kongono/http-message": "@dev",
    "kongono/http-server": "@dev",
    "kongono/identity-access": "@dev",
    "kongono/kernel": "@dev",
    "kongono/knowledge": "@dev",
    "kongono/metrics": "@dev",
    "kongono/observability": "@dev",
    "kongono/observability-application": "@dev",
    "kongono/observability-build": "@dev",
    "kongono/opentelemetry": "@dev",
    "kongono/operational-events": "@dev",
    "kongono/oshie": "@dev",
    "kongono/persistence": "@dev",
    "kongono/persistence-application": "@dev",
    "kongono/persistence-build": "@dev",
    "kongono/php-cgi": "@dev",
    "kongono/routing": "@dev",
    "kongono/security-application": "@dev",
    "kongono/security-audit": "@dev",
    "kongono/security-enforcement": "@dev",
    "kongono/security-http": "@dev",
    "kongono/security-policy-build": "@dev",
    "kongono/security-runtime": "@dev",
    "kongono/tracing": "@dev",
    "kongono/web-application": "@dev",
    "kongono/web-runtime": "@dev",
    "php": ">=8.5.0 <8.6.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^13.2"
  },
  "autoload-dev": {
    "psr-4": {
      "App\\": "skeletons/minimal/src/",
      "Kongono\\ApiMetadata\\Tests\\": "packages/api-metadata/tests/",
      "Kongono\\ApplicationGraph\\Tests\\": "packages/application-graph/tests/",
      "Kongono\\Authentication\\Tests\\": "packages/authentication/tests/",
      "Kongono\\Authorization\\Tests\\": "packages/authorization/tests/",
      "Kongono\\Chie\\Tests\\": "packages/chie/tests/",
      "Kongono\\Composition\\Tests\\": "packages/composition/tests/",
      "Kongono\\Console\\Tests\\": "packages/console/tests/",
      "Kongono\\ConsoleApplication\\Tests\\": "packages/console-application/tests/",
      "Kongono\\ConsoleBuild\\Tests\\": "packages/console-build/tests/",
      "Kongono\\ConsoleCommands\\Tests\\": "packages/console-commands/tests/",
      "Kongono\\ConsolePresentation\\Tests\\": "packages/console-presentation/tests/",
      "Kongono\\ConsoleRuntime\\Tests\\": "packages/console-runtime/tests/",
      "Kongono\\Database\\Tests\\": "packages/database/tests/",
      "Kongono\\DatabaseApplication\\Tests\\": "packages/database-application/tests/",
      "Kongono\\DatabaseMapping\\Tests\\": "packages/database-mapping/tests/",
      "Kongono\\DatabaseMigration\\Tests\\": "packages/database-migration/tests/",
      "Kongono\\DatabaseMigrationPgsql\\Tests\\": "packages/database-migration-pgsql/tests/",
      "Kongono\\DatabasePdoPgsql\\Tests\\": "packages/database-pdo-pgsql/tests/",
      "Kongono\\DatabaseSql\\Tests\\": "packages/database-sql/tests/",
      "Kongono\\DatabaseSqlPgsql\\Tests\\": "packages/database-sql-pgsql/tests/",
      "Kongono\\DependencyInjection\\Tests\\": "packages/dependency-injection/tests/",
      "Kongono\\DiagnosticActivation\\Tests\\": "packages/diagnostic-activation/tests/",
      "Kongono\\DiagnosticHandler\\Tests\\": "packages/diagnostic-handler/tests/",
      "Kongono\\DiagnosticPresentation\\Tests\\": "packages/diagnostic-presentation/tests/",
      "Kongono\\Diagnostics\\Tests\\": "packages/diagnostics/tests/",
      "Kongono\\Hantei\\Tests\\": "packages/hantei/tests/",
      "Kongono\\Http\\Message\\Tests\\": "packages/http-message/tests/",
      "Kongono\\Http\\Server\\Tests\\": "packages/http-server/tests/",
      "Kongono\\IdentityAccess\\Tests\\": "packages/identity-access/tests/",
      "Kongono\\Kernel\\Tests\\": "packages/kernel/tests/",
      "Kongono\\Knowledge\\Tests\\": "packages/knowledge/tests/",
      "Kongono\\Metrics\\Tests\\": "packages/metrics/tests/",
      "Kongono\\Observability\\Tests\\": "packages/observability/tests/",
      "Kongono\\ObservabilityApplication\\Tests\\": "packages/observability-application/tests/",
      "Kongono\\ObservabilityBuild\\Tests\\": "packages/observability-build/tests/",
      "Kongono\\OpenTelemetry\\Tests\\": "packages/opentelemetry/tests/",
      "Kongono\\OperationalEvents\\Tests\\": "packages/operational-events/tests/",
      "Kongono\\Oshie\\Tests\\": "packages/oshie/tests/",
      "Kongono\\Persistence\\Tests\\": "packages/persistence/tests/",
      "Kongono\\PersistenceApplication\\Tests\\": "packages/persistence-application/tests/",
      "Kongono\\PersistenceBuild\\Tests\\": "packages/persistence-build/tests/",
      "Kongono\\PhpCgi\\Tests\\": "packages/php-cgi/tests/",
      "Kongono\\Routing\\Tests\\": "packages/routing/tests/",
      "Kongono\\SecurityApplication\\Tests\\": "packages/security-application/tests/",
      "Kongono\\SecurityAudit\\Tests\\": "packages/security-audit/tests/",
      "Kongono\\SecurityEnforcement\\Tests\\": "packages/security-enforcement/tests/",
      "Kongono\\SecurityHttp\\Tests\\": "packages/security-http/tests/",
      "Kongono\\SecurityPolicyBuild\\Tests\\": "packages/security-policy-build/tests/",
      "Kongono\\SecurityRuntime\\Tests\\": "packages/security-runtime/tests/",
      "Kongono\\Tracing\\Tests\\": "packages/tracing/tests/",
      "Kongono\\Web\\Application\\Tests\\": "packages/web-application/tests/",
      "Kongono\\Web\\Runtime\\Tests\\": "packages/web-runtime/tests/",
      "KongonoDataMinimal\\": "skeletons/data-minimal/src/",
      "KongonoObservabilityMinimal\\": "skeletons/observability-minimal/src/",
      "KongonoPersistenceMinimal\\": "skeletons/persistence-minimal/src/",
      "KongonoSecurityMinimal\\": "skeletons/security-minimal/src/",
      "Kongono\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {},
    "platform": {
      "php": "8.5.0"
    },
    "policy": {
      "advisories": {
        "block": true,
        "audit": "fail"
      },
      "malware": {
        "block": true,
        "block-scope": "all",
        "audit": "fail"
      },
      "abandoned": {
        "block": true,
        "audit": "fail"
      },
      "ignore-unreachable": false
    },
    "preferred-install": "dist",
    "secure-http": true,
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist",
    "acceptance:phase3": "@php tests/External/PhpCgi/run.php",
    "acceptance:phase4": "@php tests/External/DeveloperIntelligence/run.php",
    "acceptance:phase5": "@php tests/External/Application/run.php",
    "acceptance:phase6": "@php tests/External/Database/run.php",
    "acceptance:phase7": "@php tests/External/Persistence/run.php",
    "acceptance:phase8": "@php tests/External/Console/run.php",
    "acceptance:phase9": "@php tests/External/Security/run.php",
    "acceptance:phase10": "@php tests/External/Observability/run.php",
    "analyse": "@php -d memory_limit=512M vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --no-progress",
    "cs": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
    "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
    "audit:locked": "composer audit --locked",
    "platform": "composer check-platform-reqs",
    "validate:composer": "composer validate --no-check-publish",
    "validate:packages": [
      "composer --working-dir=packages/api-metadata validate --no-check-publish",
      "composer --working-dir=packages/application-graph validate --no-check-publish",
      "composer --working-dir=packages/authentication validate --no-check-publish",
      "composer --working-dir=packages/authorization validate --no-check-publish",
      "composer --working-dir=packages/chie validate --no-check-publish",
      "composer --working-dir=packages/composition validate --no-check-publish",
      "composer --working-dir=packages/console validate --no-check-publish",
      "composer --working-dir=packages/console-application validate --no-check-publish",
      "composer --working-dir=packages/console-build validate --no-check-publish",
      "composer --working-dir=packages/console-commands validate --no-check-publish",
      "composer --working-dir=packages/console-presentation validate --no-check-publish",
      "composer --working-dir=packages/console-runtime validate --no-check-publish",
      "composer --working-dir=packages/database validate --no-check-publish",
      "composer --working-dir=packages/database-application validate --no-check-publish",
      "composer --working-dir=packages/database-mapping validate --no-check-publish",
      "composer --working-dir=packages/database-migration validate --no-check-publish",
      "composer --working-dir=packages/database-migration-pgsql validate --no-check-publish",
      "composer --working-dir=packages/database-pdo-pgsql validate --no-check-publish",
      "composer --working-dir=packages/database-sql validate --no-check-publish",
      "composer --working-dir=packages/database-sql-pgsql validate --no-check-publish",
      "composer --working-dir=packages/dependency-injection validate --no-check-publish",
      "composer --working-dir=packages/diagnostic-activation validate --no-check-publish",
      "composer --working-dir=packages/diagnostic-handler validate --no-check-publish",
      "composer --working-dir=packages/diagnostic-presentation validate --no-check-publish",
      "composer --working-dir=packages/diagnostics validate --no-check-publish",
      "composer --working-dir=packages/hantei validate --no-check-publish",
      "composer --working-dir=packages/http-message validate --no-check-publish",
      "composer --working-dir=packages/http-server validate --no-check-publish",
      "composer --working-dir=packages/identity-access validate --no-check-publish",
      "composer --working-dir=packages/kernel validate --no-check-publish",
      "composer --working-dir=packages/knowledge validate --no-check-publish",
      "composer --working-dir=packages/metrics validate --no-check-publish",
      "composer --working-dir=packages/observability validate --no-check-publish",
      "composer --working-dir=packages/observability-application validate --no-check-publish",
      "composer --working-dir=packages/observability-build validate --no-check-publish",
      "composer --working-dir=packages/opentelemetry validate --no-check-publish",
      "composer --working-dir=packages/operational-events validate --no-check-publish",
      "composer --working-dir=packages/oshie validate --no-check-publish",
      "composer --working-dir=packages/persistence validate --no-check-publish",
      "composer --working-dir=packages/persistence-application validate --no-check-publish",
      "composer --working-dir=packages/persistence-build validate --no-check-publish",
      "composer --working-dir=packages/php-cgi validate --no-check-publish",
      "composer --working-dir=packages/routing validate --no-check-publish",
      "composer --working-dir=packages/security-application validate --no-check-publish",
      "composer --working-dir=packages/security-audit validate --no-check-publish",
      "composer --working-dir=packages/security-enforcement validate --no-check-publish",
      "composer --working-dir=packages/security-http validate --no-check-publish",
      "composer --working-dir=packages/security-policy-build validate --no-check-publish",
      "composer --working-dir=packages/security-runtime validate --no-check-publish",
      "composer --working-dir=packages/tracing validate --no-check-publish",
      "composer --working-dir=packages/web-application validate --no-check-publish",
      "composer --working-dir=packages/web-runtime validate --no-check-publish"
    ],
    "validate:skeleton": [
      "composer --working-dir=skeletons/data-minimal validate --no-check-publish",
      "composer --working-dir=skeletons/minimal validate --no-check-publish",
      "composer --working-dir=skeletons/observability-minimal validate --no-check-publish",
      "composer --working-dir=skeletons/persistence-minimal validate --no-check-publish",
      "composer --working-dir=skeletons/security-minimal validate --no-check-publish"
    ],
    "knowledge:check": "@php packages/knowledge/bin/kongono-knowledge check .",
    "hantei:verify": "@php packages/hantei/bin/kongono-hantei verify .",
    "oshie": "@php packages/oshie/bin/kongono-oshie",
    "quality": [
      "@validate:composer",
      "@validate:packages",
      "@validate:skeleton",
      "@audit:locked",
      "@platform",
      "@knowledge:check",
      "@cs",
      "@analyse",
      "@test"
    ]
  }
}
