{
  "name": "kongono/framework",
  "description": "A modern, zero-legacy PHP 8.5+ application framework built from the ground up with zero Symfony dependency and integrated Oshie (learn), Chie (build), and Hantei (debug/test) AI companions.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "php",
    "php85",
    "framework",
    "ai",
    "mcp",
    "rag",
    "pgvector",
    "frankenphp",
    "openapi",
    "psr-7",
    "psr-15",
    "zero-legacy"
  ],
  "homepage": "https://kongono.com",
  "authors": [
    {
      "name": "Anthony Iovanna",
      "email": "ant@kongono.com"
    }
  ],
  "support": {
    "issues": "https://github.com/kongono/framework/issues",
    "source": "https://github.com/kongono/framework",
    "docs": "https://kongono.com/docs"
  },
  "require": {
    "php": ">=8.5.13",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-sodium": "*",
    "psr/container": "^2.0",
    "psr/event-dispatcher": "^1.0",
    "psr/http-factory": "^1.1",
    "psr/http-message": "^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^13.2"
  },
  "replace": {
    "kongono/ai": "self.version",
    "kongono/cli": "self.version",
    "kongono/core": "self.version",
    "kongono/database": "self.version",
    "kongono/http": "self.version",
    "kongono/jobs": "self.version",
    "kongono/mail": "self.version",
    "kongono/security": "self.version",
    "kongono/storage": "self.version",
    "kongono/validation": "self.version",
    "kongono/view": "self.version"
  },
  "suggest": {
    "ext-openssl": "Required for STARTTLS SMTP email delivery and TLS Redis connections.",
    "ext-pdo_pgsql": "Required for PostgreSQL, pgvector semantic search, and PostgresQueueDriver.",
    "ext-pdo_sqlite": "Optional for lightweight local SQLite databases.",
    "ext-zlib": "Required for HTTP gzip/deflate response compression via CompressionMiddleware."
  },
  "autoload": {
    "psr-4": {
      "Kongono\\Core\\": "packages/core/src/",
      "Kongono\\Http\\": "packages/http/src/",
      "Kongono\\View\\": "packages/view/src/",
      "Kongono\\Validation\\": "packages/validation/src/",
      "Kongono\\Database\\": "packages/database/src/",
      "Kongono\\Security\\": "packages/security/src/",
      "Kongono\\Storage\\": "packages/storage/src/",
      "Kongono\\Jobs\\": "packages/jobs/src/",
      "Kongono\\Mail\\": "packages/mail/src/",
      "Kongono\\Ai\\": "packages/ai/src/",
      "Kongono\\Cli\\": "packages/cli/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kongono\\Core\\Tests\\": "packages/core/tests/",
      "Kongono\\Http\\Tests\\": "packages/http/tests/",
      "Kongono\\View\\Tests\\": "packages/view/tests/",
      "Kongono\\Validation\\Tests\\": "packages/validation/tests/",
      "Kongono\\Database\\Tests\\": "packages/database/tests/",
      "Kongono\\Security\\Tests\\": "packages/security/tests/",
      "Kongono\\Storage\\Tests\\": "packages/storage/tests/",
      "Kongono\\Jobs\\Tests\\": "packages/jobs/tests/",
      "Kongono\\Mail\\Tests\\": "packages/mail/tests/",
      "Kongono\\Ai\\Tests\\": "packages/ai/tests/",
      "Kongono\\Cli\\Tests\\": "packages/cli/tests/",
      "Kongono\\Tests\\Fuzz\\": "tests/Fuzz/",
      "Kongono\\Tests\\Integration\\": "tests/Integration/",
      "StarterApp\\": "examples/starter-app/src/",
      "StarterApp\\Tests\\": "examples/starter-app/tests/"
    }
  },
  "bin": [
    "bin/kongo"
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  },
  "scripts": {
    "test": "@php -d memory_limit=512M vendor/bin/phpunit --configuration phpunit.xml.dist",
    "test:integration": "@php -d memory_limit=512M vendor/bin/phpunit --configuration phpunit.xml.dist tests/Integration",
    "fuzz": "@php -d memory_limit=512M vendor/bin/phpunit --configuration phpunit.xml.dist --fail-on-deprecation --fail-on-warning --fail-on-notice tests/Fuzz",
    "analyse": "@php -d memory_limit=512M vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --no-progress",
    "cs": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
    "cs:fix": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php",
    "quality": [
      "@cs",
      "@analyse",
      "@test"
    ]
  }
}
