<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         executionOrder="defects"
         resolveDependencies="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="Core">
            <directory>packages/core/tests</directory>
        </testsuite>
        <testsuite name="Http">
            <directory>packages/http/tests</directory>
        </testsuite>
        <testsuite name="View">
            <directory>packages/view/tests</directory>
        </testsuite>
        <testsuite name="Validation">
            <directory>packages/validation/tests</directory>
        </testsuite>
        <testsuite name="Database">
            <directory>packages/database/tests</directory>
        </testsuite>
        <testsuite name="Security">
            <directory>packages/security/tests</directory>
        </testsuite>
        <testsuite name="Storage">
            <directory>packages/storage/tests</directory>
        </testsuite>
        <testsuite name="Jobs">
            <directory>packages/jobs/tests</directory>
        </testsuite>
        <testsuite name="Ai">
            <directory>packages/ai/tests</directory>
        </testsuite>
        <testsuite name="Cli">
            <directory>packages/cli/tests</directory>
        </testsuite>
        <testsuite name="StarterApp">
            <directory>examples/starter-app/tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
