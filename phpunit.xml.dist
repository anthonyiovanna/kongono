<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.2/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         failOnDeprecation="true"
         failOnPhpunitDeprecation="true"
         failOnNotice="true"
         failOnIncomplete="true"
         failOnEmptyTestSuite="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="Kongono">
            <directory>packages/api-metadata/tests</directory>
            <directory>packages/application-graph/tests</directory>
            <directory>packages/chie/tests</directory>
            <directory>packages/composition/tests</directory>
            <directory>packages/console/tests</directory>
            <directory>packages/console-application/tests</directory>
            <directory>packages/console-build/tests</directory>
            <directory>packages/console-commands/tests</directory>
            <directory>packages/console-presentation/tests</directory>
            <directory>packages/console-runtime/tests</directory>
            <directory>packages/database/tests</directory>
            <directory>packages/database-application/tests</directory>
            <directory>packages/database-mapping/tests</directory>
            <directory>packages/database-migration/tests</directory>
            <directory>packages/database-migration-pgsql/tests</directory>
            <directory>packages/database-pdo-pgsql/tests</directory>
            <directory>packages/database-sql/tests</directory>
            <directory>packages/database-sql-pgsql/tests</directory>
            <directory>packages/dependency-injection/tests</directory>
            <directory>packages/diagnostic-activation/tests</directory>
            <directory>packages/diagnostic-handler/tests</directory>
            <directory>packages/diagnostic-presentation/tests</directory>
            <directory>packages/diagnostics/tests</directory>
            <directory>packages/hantei/tests</directory>
            <directory>packages/http-message/tests</directory>
            <directory>packages/http-server/tests</directory>
            <directory>packages/kernel/tests</directory>
            <directory>packages/knowledge/tests</directory>
            <directory>packages/oshie/tests</directory>
            <directory>packages/persistence/tests</directory>
            <directory>packages/persistence-application/tests</directory>
            <directory>packages/persistence-build/tests</directory>
            <directory>packages/php-cgi/tests</directory>
            <directory>packages/routing/tests</directory>
            <directory>packages/web-application/tests</directory>
            <directory>packages/web-runtime/tests</directory>
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>packages/api-metadata/src</directory>
            <directory>packages/application-graph/src</directory>
            <directory>packages/chie/src</directory>
            <directory>packages/composition/src</directory>
            <directory>packages/console/src</directory>
            <directory>packages/console-application/src</directory>
            <directory>packages/console-build/src</directory>
            <directory>packages/console-commands/src</directory>
            <directory>packages/console-presentation/src</directory>
            <directory>packages/console-runtime/src</directory>
            <directory>packages/database/src</directory>
            <directory>packages/database-application/src</directory>
            <directory>packages/database-mapping/src</directory>
            <directory>packages/database-migration/src</directory>
            <directory>packages/database-migration-pgsql/src</directory>
            <directory>packages/database-pdo-pgsql/src</directory>
            <directory>packages/database-sql/src</directory>
            <directory>packages/database-sql-pgsql/src</directory>
            <directory>packages/dependency-injection/src</directory>
            <directory>packages/diagnostic-activation/src</directory>
            <directory>packages/diagnostic-handler/src</directory>
            <directory>packages/diagnostic-presentation/src</directory>
            <directory>packages/diagnostics/src</directory>
            <directory>packages/hantei/src</directory>
            <directory>packages/http-message/src</directory>
            <directory>packages/http-server/src</directory>
            <directory>packages/kernel/src</directory>
            <directory>packages/knowledge/src</directory>
            <directory>packages/oshie/src</directory>
            <directory>packages/persistence/src</directory>
            <directory>packages/persistence-application/src</directory>
            <directory>packages/persistence-build/src</directory>
            <directory>packages/php-cgi/src</directory>
            <directory>packages/routing/src</directory>
            <directory>packages/web-application/src</directory>
            <directory>packages/web-runtime/src</directory>
            <directory>skeletons/data-minimal/src</directory>
            <directory>skeletons/minimal/src</directory>
            <directory>skeletons/persistence-minimal/src</directory>
        </include>
    </source>
</phpunit>
