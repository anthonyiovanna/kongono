#!/usr/bin/env php
<?php

declare(strict_types=1);

use Kongono\Cli\KongoCli;

$autoload = dirname(__DIR__) . '/vendor/autoload.php';
if (!is_file($autoload)) {
    fwrite(STDERR, "Vendor autoloader not found. Run `composer dump-autoload`.\n");
    exit(1);
}
require $autoload;

/** @var list<string> $argv */
$args = array_slice($argv, 1);
$cwd = getcwd();
$cli = new KongoCli(false !== $cwd ? $cwd : dirname(__DIR__));
[$exitCode, $output] = $cli->run($args);

if ('' !== $output) {
    fwrite(0 === $exitCode ? STDOUT : STDERR, $output);
}

exit($exitCode);
